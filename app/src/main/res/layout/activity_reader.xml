<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/readerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/readerControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFDF8"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/readerProgressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Reading progress"
                android:text="0% through book"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/readerStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Preparing reader…"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/readerAppearanceButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reading appearance settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:tint="#333333" />

            <ImageButton
                android:id="@+id/closeReaderButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Return to library"
                android:padding="12dp"
                android:src="@drawable/ic_library_shelf"
                android:tint="#333333" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/readerProgressSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Reading progress. Drag to move through the book."
            android:max="100"
            android:progress="0" />
    </LinearLayout>
</LinearLayout>
